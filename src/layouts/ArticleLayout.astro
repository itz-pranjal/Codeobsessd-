---
import DifficultyBadge from '../components/DifficultyBadge.astro';
import BaseLayout from './BaseLayout.astro';

const { frontmatter, readingTime, relatedArticles, prevArticle, nextArticle } = Astro.props;
const { title, description, difficulty, coverImage, quickAnswer } = frontmatter;
const dateStr = new Date(frontmatter.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const monthYear = new Date(frontmatter.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long' });
const wordCount = Astro.slots.render ? 50 : 50;
---
<BaseLayout title={`${title} — CodeObsessed`}>
  <article class="article">
    <header class="article-header">
      <DifficultyBadge difficulty={difficulty} />
      <h1 class="article-title">{title}</h1>
      <div class="article-meta">
        <span>{frontmatter.author || 'Pranjal Bhatt'}</span>
        <span class="meta-sep">•</span>
        <span>{dateStr}</span>
        <span class="meta-sep">•</span>
        <span>{readingTime} min read</span>
      </div>
      <div class="info-pills">
        <span class="pill">📖 {readingTime} min read</span>
        <span class="pill">📅 {monthYear}</span>
        <span class="pill">🏷 {difficulty}</span>
      </div>
      <div class="meta-divider"></div>
    </header>

    {quickAnswer && (
      <div class="quick-answer-box">
        <strong class="qa-label">Quick Answer</strong>
        <p class="qa-text">{quickAnswer}</p>
      </div>
    )}

    {coverImage && (
      <div class="cover-wrapper">
        <img src={coverImage} alt="" class="cover-image" loading="lazy" decoding="async" onerror="this.onerror=null;this.style.display='none';this.nextElementSibling.style.display='flex'" />
        <div class="cover-fallback" style="display:none"><span>CodeObsessed</span></div>
      </div>
    )}

    <div class="article-content">
      <slot />
    </div>

    {relatedArticles && relatedArticles.length > 0 && (
      <section class="related-section">
        <h2 class="related-title">Related Articles</h2>
        <div class="related-grid">
          {relatedArticles.map(a => (
            <a href={`/articles/${a.slug}`} class="related-card">
              <div class="related-card-image-wrapper">
                {a.frontmatter.coverImage ? (
                  <img src={a.frontmatter.coverImage} alt="" class="related-card-image" loading="lazy" decoding="async" onerror="this.onerror=null;this.style.display='none';this.parentElement.querySelector('.related-fallback').style.display='flex'" />
                ) : null}
                <div class="related-fallback" style="display:none"><span class="related-fallback-letter">{(a.frontmatter.title || 'C').charAt(0)}</span></div>
              </div>
              <div class="related-card-body">
                <h3 class="related-card-title">{a.frontmatter.title}</h3>
                <DifficultyBadge difficulty={a.frontmatter.difficulty} />
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <nav class="prev-next">
      {prevArticle ? (
        <a href={`/articles/${prevArticle.slug}`} class="prev">
          <span class="direction">← Previous</span>
          <span class="pn-title">{prevArticle.frontmatter.title}</span>
        </a>
      ) : <div />}
      {nextArticle ? (
        <a href={`/articles/${nextArticle.slug}`} class="next">
          <span class="direction">Next →</span>
          <span class="pn-title">{nextArticle.frontmatter.title}</span>
        </a>
      ) : <div />}
    </nav>
  </article>
</BaseLayout>

<script>
  const bar = document.getElementById('progress-bar');
  if (bar) {
    window.addEventListener('scroll', () => {
      const scrolled = window.scrollY;
      const total = document.body.scrollHeight - window.innerHeight;
      const percent = (scrolled / total) * 100;
      bar.style.width = percent + '%';
    });
  }
</script>

<style>
  .article {
    max-width: 740px;
    margin: 0 auto;
    padding: 2rem 0;
  }

  .article-header {
    margin-bottom: 1.5rem;
  }

  .article-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 2.6rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--text-primary);
    margin: 0.75rem 0 0.75rem;
  }

  .article-meta {
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .meta-sep {
    color: #4b5563;
  }

  .info-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--bg-card);
    border: 1px solid #2a2a2a;
    border-radius: 999px;
    padding: 0.3rem 0.85rem;
    font-size: 0.8rem;
    font-family: 'Inter', sans-serif;
    color: var(--text-muted);
  }

  .meta-divider {
    height: 1px;
    background: #1f1f1f;
    margin: 1.5rem 0;
  }

  .quick-answer-box {
    background: var(--accent-dim);
    border-left: 3px solid var(--accent);
    padding: 1.25rem 1.5rem;
    border-radius: 0 8px 8px 0;
    color: #d4d4d4;
    margin-bottom: 2rem;
  }

  .qa-label {
    display: block;
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .qa-text {
    margin: 0;
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    line-height: 1.7;
    color: #d4d4d4;
  }

  .cover-wrapper {
    margin-bottom: 2.5rem;
    position: relative;
  }

  .cover-image {
    width: 100%;
    height: 380px;
    object-fit: cover;
    border-radius: 12px;
    display: block;
  }

  .cover-fallback {
    width: 100%;
    height: 380px;
    background: var(--bg-card);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cover-fallback span {
    color: var(--accent);
    font-family: 'Inter', monospace;
    font-weight: 600;
    font-size: 1rem;
  }

  .article-content {
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    line-height: 1.85;
    color: #d4d4d4;
  }

  .article-content :global(blockquote) {
    background: var(--accent-dim);
    border-left: 3px solid var(--accent);
    padding: 1.25rem 1.5rem;
    border-radius: 0 8px 8px 0;
    color: #d4d4d4;
    margin: 0 0 2rem;
    font-size: 1rem;
    line-height: 1.7;
  }

  .article-content :global(blockquote) :global(p) {
    margin: 0;
  }

  .article-content :global(h2) {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .article-content :global(h3) {
    font-family: 'Playfair Display', serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .article-content :global(p) {
    margin-bottom: 1.25rem;
  }

  .article-content :global(ul), .article-content :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .article-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .article-content :global(code) {
    background: var(--bg-card);
    color: var(--accent);
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    font-family: 'Fira Code', 'JetBrains Mono', monospace;
    font-size: 0.9em;
  }

  .article-content :global(pre) {
    background: var(--bg-card);
    color: #d4d4d4;
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
    font-family: 'Fira Code', 'JetBrains Mono', monospace;
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .article-content :global(pre code) {
    background: none;
    padding: 0;
    font-size: inherit;
    color: inherit;
  }

  .article-content :global(hr) {
    border: none;
    border-top: 1px solid #1f1f1f;
    margin: 2rem 0;
  }

  .related-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid #1f1f1f;
  }

  .related-title {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 1.25rem;
  }

  .related-grid {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
  }

  .related-card {
    flex: 0 0 220px;
    background: var(--bg-card);
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: transform 0.2s;
  }

  .related-card:hover {
    transform: translateY(-2px);
    text-decoration: none;
  }

  .related-card-image-wrapper {
    height: 110px;
    overflow: hidden;
  }

  .related-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .related-fallback {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #0f2027, #1a1a2e);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .related-fallback-letter {
    font-size: 3rem;
    color: #22c55e;
    font-family: monospace;
  }

  .related-card-body {
    padding: 0.75rem;
  }

  .related-card-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.5rem;
    line-height: 1.3;
  }

  .prev-next {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid #1f1f1f;
  }

  .prev-next a {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 1rem;
    background: var(--bg-card);
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.15s;
  }

  .prev-next a:hover {
    background: #222;
    text-decoration: none;
  }

  .direction {
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    color: var(--accent);
    margin-bottom: 0.25rem;
  }

  .pn-title {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    color: #9ca3af;
    line-height: 1.4;
  }

  .next {
    text-align: right;
  }

  @media (max-width: 1024px) {
    .article-content {
      font-size: 1rem;
    }
  }

  @media (max-width: 768px) {
    .article {
      padding: 2rem 1.5rem;
    }

    .article-title {
      font-size: 1.8rem;
    }

    .cover-image {
      height: 240px;
    }

    .cover-fallback {
      height: 240px;
    }

    .article-content {
      font-size: 1rem;
    }

    .prev-next {
      flex-direction: column;
    }

    .next {
      text-align: left;
    }

    .related-card {
      flex: 0 0 180px;
    }
  }

  @media (max-width: 480px) {
    .article {
      padding: 2rem 1rem;
    }

    .article-title {
      font-size: 1.6rem;
    }

    .article-content {
      font-size: 0.95rem;
    }

    .cover-image {
      height: 220px;
    }

    .cover-fallback {
      height: 220px;
    }
  }

  @media (max-width: 380px) {
    .article-title {
      font-size: 1.4rem;
    }
  }
</style>
