---
const { difficulty } = Astro.props;
const config = {
  Beginner: { bg: '#052e16', text: '#22c55e', label: 'Beginner' },
  Intermediate: { bg: '#1c1917', text: '#f59e0b', label: 'Intermediate' },
  Both: { bg: '#0c1a2e', text: '#60a5fa', label: 'All Levels' },
};
const { bg, text, label } = config[difficulty] || config.Beginner;
---
<span class="badge" style={{ backgroundColor: bg, color: text }}>{label}</span>

<style>
  .badge {
    display: inline-block;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    font-family: 'Inter', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }
</style>
