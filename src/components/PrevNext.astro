---
const { prev, next } = Astro.props;
---
<nav class="prev-next">
  {prev ? (
    <a href={`/articles/${prev.slug}`} class="prev">
      <span class="direction">← Previous</span>
      <span class="title">{prev.frontmatter.title}</span>
    </a>
  ) : <div />}
  {next ? (
    <a href={`/articles/${next.slug}`} class="next">
      <span class="direction">Next →</span>
      <span class="title">{next.frontmatter.title}</span>
    </a>
  ) : <div />}
</nav>

<style>
  .prev-next {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid #1f1f1f;
  }

  .prev-next a {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 1rem;
    background: var(--bg-card);
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.15s;
  }

  .prev-next a:hover {
    background: #222;
    text-decoration: none;
  }

  .direction {
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    color: var(--accent);
    margin-bottom: 0.25rem;
  }

  .title {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    color: #9ca3af;
    line-height: 1.4;
  }

  .next {
    text-align: right;
  }

  @media (max-width: 640px) {
    .prev-next {
      flex-direction: column;
    }

    .next {
      text-align: left;
    }
  }
</style>
