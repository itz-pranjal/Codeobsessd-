<canvas id="matrix-canvas"></canvas>

<script>
  const canvas = document.getElementById('matrix-canvas');
  const ctx = canvas.getContext('2d');
  let columns = [];
  let columnCount = 0;
  let animId = null;
  let lastFrame = 0;
  const fps = 30;
  const interval = 1000 / fps;
  const fontSize = 16;
  const spacing = 18;

  const chars = "01{}[]();=></*#@$&|~^%ABCDEFabcdef";

  function getAccentColor() {
    return getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#22c55e';
  }

  function hexToRgb(hex) {
    const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
    return result ? parseInt(result[1], 16) + ',' + parseInt(result[2], 16) + ',' + parseInt(result[3], 16) : '34,197,94';
  }

  function resize() {
    const rect = canvas.parentElement.getBoundingClientRect();
    canvas.width = rect.width;
    canvas.height = Math.max(rect.height, 320);
    columnCount = Math.floor(canvas.width / spacing);
    columns = [];
    for (let i = 0; i < columnCount; i++) {
      columns.push({
        y: Math.random() * canvas.height,
        speed: 1 + Math.random() * 1.5,
      });
    }
  }

  function draw(timestamp) {
    if (timestamp - lastFrame < interval) {
      animId = requestAnimationFrame(draw);
      return;
    }
    lastFrame = timestamp;

    ctx.fillStyle = 'rgba(15, 15, 15, 0.05)';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    ctx.font = fontSize + 'px monospace';
    const accent = getAccentColor();
    const accentRgb = hexToRgb(accent);

    for (let i = 0; i < columns.length; i++) {
      const col = columns[i];
      const x = i * spacing;
      const char = chars[Math.floor(Math.random() * chars.length)];

      ctx.fillStyle = '#ffffff';
      ctx.fillText(char, x, col.y);

      ctx.fillStyle = accent;
      ctx.fillText(char, x, col.y - spacing);

      ctx.fillStyle = `rgba(${accentRgb}, 0.8)`;
      ctx.fillText(char, x, col.y - spacing * 2);

      ctx.fillStyle = `rgba(${accentRgb}, 0.6)`;
      ctx.fillText(char, x, col.y - spacing * 3);

      ctx.fillStyle = `rgba(${accentRgb}, 0.4)`;
      ctx.fillText(char, x, col.y - spacing * 4);

      ctx.fillStyle = `rgba(${accentRgb}, 0.2)`;
      ctx.fillText(char, x, col.y - spacing * 5);

      ctx.fillStyle = `rgba(${accentRgb}, 0.1)`;
      ctx.fillText(char, x, col.y - spacing * 6);

      if (col.y > canvas.height + spacing * 6) {
        col.y = 0;
        col.speed = 1 + Math.random() * 1.5;
      }
      col.y += col.speed;
    }

    animId = requestAnimationFrame(draw);
  }

  resize();
  animId = requestAnimationFrame(draw);

  const ro = new ResizeObserver(() => {
    resize();
  });
  ro.observe(canvas.parentElement);
</script>

<style>
  canvas {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 320px;
    border-radius: 16px;
    background: #0f0f0f;
  }
</style>
