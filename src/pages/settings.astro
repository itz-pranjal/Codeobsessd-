---
import BaseLayout from '../layouts/BaseLayout.astro';
const themes = [
  {
    id: 'hacker-green',
    name: 'Hacker Green',
    desc: 'The classic. Dark and focused.',
    swatch: 'linear-gradient(135deg, #0f0f0f, #1a1a1a)',
    accent: '#22c55e',
  },
  {
    id: 'midnight-blue',
    name: 'Midnight Blue',
    desc: 'Cool and calm. Easy on the eyes.',
    swatch: 'linear-gradient(135deg, #0a0f1e, #111827)',
    accent: '#60a5fa',
  },
  {
    id: 'amber-terminal',
    name: 'Amber Terminal',
    desc: 'Warm retro terminal feel.',
    swatch: 'linear-gradient(135deg, #0f0a00, #1a1400)',
    accent: '#f59e0b',
  },
  {
    id: 'crimson-dark',
    name: 'Crimson Dark',
    desc: 'Bold and high contrast.',
    swatch: 'linear-gradient(135deg, #0f0005, #1a0010)',
    accent: '#f43f5e',
  },
];
const defaultTheme = 'hacker-green';
---

<BaseLayout title="Settings — CodeObsessed">
  <h1 class="settings-title">Settings</h1>
  <h2 class="settings-section">Colour Theme</h2>
  <div class="theme-grid">
    {themes.map(t => (
      <div class="theme-card" data-theme={t.id}>
        <div class="theme-swatch" style={{ background: t.swatch, borderBottom: `3px solid ${t.accent}` }}></div>
        <div class="theme-label">{t.name}</div>
        <div class="theme-desc">{t.desc}</div>
      </div>
    ))}
  </div>

</BaseLayout>

<script>
  const themes = {
    'hacker-green': {
      '--accent': '#22c55e',
      '--accent-dim': '#052e16',
      '--accent-text': '#22c55e',
      '--bg-base': '#0f0f0f',
      '--bg-card': '#1a1a1a',
    },
    'midnight-blue': {
      '--accent': '#60a5fa',
      '--accent-dim': '#0c1a2e',
      '--accent-text': '#60a5fa',
      '--bg-base': '#0a0f1e',
      '--bg-card': '#111827',
    },
    'amber-terminal': {
      '--accent': '#f59e0b',
      '--accent-dim': '#1c1000',
      '--accent-text': '#f59e0b',
      '--bg-base': '#0f0a00',
      '--bg-card': '#1a1400',
    },
    'crimson-dark': {
      '--accent': '#f43f5e',
      '--accent-dim': '#1f0010',
      '--accent-text': '#f43f5e',
      '--bg-base': '#0f0005',
      '--bg-card': '#1a0010',
    },
  };

  function applyTheme(themeId) {
    const vars = themes[themeId] || themes['hacker-green'];
    const root = document.documentElement;
    Object.entries(vars).forEach(([key, val]) => {
      root.style.setProperty(key, val);
    });
    document.querySelectorAll('[data-theme]').forEach(c => {
      c.classList.toggle('active', c.dataset.theme === themeId);
    });
  }

  const saved = localStorage.getItem('co-theme') || 'hacker-green';
  applyTheme(saved);

  document.querySelectorAll('[data-theme]').forEach(card => {
    card.addEventListener('click', () => {
      const themeId = card.dataset.theme;
      localStorage.setItem('co-theme', themeId);
      applyTheme(themeId);
    });
  });

</script>

<style>
  .settings-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 2rem 0 0.25rem;
  }

  .settings-section {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin: 2rem 0 1rem;
  }

  .theme-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .theme-card {
    background: var(--bg-card);
    border-radius: 12px;
    padding: 1.25rem;
    border: 2px solid transparent;
    cursor: pointer;
    transition: filter 0.2s;
  }

  .theme-card:hover {
    filter: brightness(1.15);
  }

  .theme-card.active {
    border-color: var(--accent);
  }

  .theme-swatch {
    width: 100%;
    height: 60px;
    border-radius: 8px;
    margin-bottom: 0.75rem;
  }

  .theme-label {
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 1rem;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .theme-desc {
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  @media (max-width: 480px) {
    .theme-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
