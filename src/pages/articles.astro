---
// Articles list page with filter buttons and sorted article entries
import BaseLayout from '../layouts/BaseLayout.astro';
import DifficultyBadge from '../components/DifficultyBadge.astro';

const articles = Object.values(import.meta.glob('../content/articles/*.md', { eager: true }));
const sorted = articles
  .map(a => ({ ...a, slug: a.file.split('/').pop().replace('.md', '') }))
  .sort((a, b) => new Date(b.frontmatter.date) - new Date(a.frontmatter.date));
---
<BaseLayout title="Articles — CodeObsessed">
  <h1 class="page-title">All Articles</h1>

  <div class="filters">
    <button class="filter active" data-filter="all">All</button>
    <button class="filter" data-filter="Beginner">Beginner</button>
    <button class="filter" data-filter="Intermediate">Intermediate</button>
  </div>

  <div class="article-list">
    {sorted.map(a => (
      <a href={`/articles/${a.slug}`} class="article-entry" data-difficulty={a.frontmatter.difficulty}>
        <div class="entry-info">
          <h2 class="entry-title">{a.frontmatter.title}</h2>
          {a.frontmatter.description && <p class="entry-desc">{a.frontmatter.description}</p>}
          <div class="entry-meta">
            <DifficultyBadge difficulty={a.frontmatter.difficulty} />
            <span class="entry-date">{new Date(a.frontmatter.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
          </div>
        </div>
      </a>
    ))}
  </div>
</BaseLayout>

<script>
  const filters = document.querySelectorAll('.filter');
  const entries = document.querySelectorAll('.article-entry');

  filters.forEach(btn => {
    btn.addEventListener('click', () => {
      filters.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const filter = btn.dataset.filter;
      entries.forEach(entry => {
        if (filter === 'all' || entry.dataset.difficulty === filter) {
          entry.style.display = '';
        } else {
          entry.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  .page-title {
    font-family: var(--font-heading);
    font-size: 2rem;
    margin: 2rem 0 1.5rem;
  }

  .filters {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .filter {
    padding: 0.5rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-card);
    color: var(--text-secondary);
    font-family: var(--font-heading);
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.15s;
  }

  .filter:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .filter.active {
    background: var(--accent);
    color: white;
    border-color: var(--accent);
  }

  .article-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-bottom: 2rem;
  }

  .article-entry {
    display: block;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s;
  }

  .article-entry:hover {
    border-color: var(--accent);
    text-decoration: none;
  }

  .entry-title {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    margin: 0 0 0.5rem;
    color: var(--text);
  }

  .entry-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin: 0 0 0.75rem;
    line-height: 1.5;
  }

  .entry-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .entry-date {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  @media (max-width: 640px) {
    .page-title {
      font-size: 1.5rem;
    }
  }
</style>
