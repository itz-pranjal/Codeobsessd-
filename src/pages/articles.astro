---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuestionCard from '../components/QuestionCard.astro';

const articles = Object.values(import.meta.glob('../content/articles/*.md', { eager: true }));
const sorted = articles
  .map(a => ({ ...a, slug: a.file.split('/').pop().replace('.md', '') }))
  .sort((a, b) => new Date(b.frontmatter.date) - new Date(a.frontmatter.date));
---
<BaseLayout title="Articles — CodeObsessed">
  <h1 class="page-title">All Articles</h1>
  <p class="page-subtitle">Honest answers for coders at every level.</p>

  <div class="filters">
    <button class="filter active" data-filter="all">All</button>
    <button class="filter" data-filter="Beginner">Beginner</button>
    <button class="filter" data-filter="Intermediate">Intermediate</button>
    <button class="filter" data-filter="Both">All Levels</button>
  </div>

  <div class="card-grid" id="articleGrid">
    {sorted.map(a => (
      <div class="card-wrapper" data-difficulty={a.frontmatter.difficulty}>
        <QuestionCard article={a} />
      </div>
    ))}
  </div>
</BaseLayout>

<script>
  const filters = document.querySelectorAll('.filter');
  const wrappers = document.querySelectorAll('.card-wrapper');

  filters.forEach(btn => {
    btn.addEventListener('click', () => {
      filters.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const filter = btn.dataset.filter;
      wrappers.forEach(w => {
        if (filter === 'all' || w.dataset.difficulty === filter) {
          w.style.display = '';
        } else {
          w.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  .page-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 2rem 0 0.25rem;
  }

  .page-subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    color: var(--text-muted);
    margin: 0 0 2rem;
  }

  .filters {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .filter {
    padding: 0.4rem 1rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: var(--bg-card);
    color: var(--text-muted);
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.15s;
  }

  .filter:hover {
    color: var(--accent);
  }

  .filter.active {
    background: var(--accent-dim);
    color: var(--accent);
    border-color: var(--accent);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
    padding-bottom: 3rem;
  }

  @media (max-width: 1024px) {
    .card-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
  }

  @media (max-width: 768px) {
    .card-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
  }

  @media (max-width: 480px) {
    .card-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
